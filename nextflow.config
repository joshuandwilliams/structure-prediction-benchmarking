/*
 * Resource profiles and executor settings for the benchmark pipeline.
 *
 * Predictors are grouped by resource envelope rather than named individually.
 * GPU processes carry maxForks so only one job of a given model runs at a
 * time, respecting the small jic-gpu queue.
 */

params {
    project_name     = "structure_prediction_benchmark"
    outdir           = "${launchDir}/${params.project_name}_results"

    // One GPU job per model at a time. Different models still run in
    // parallel, and seeds within a model are already serial.
    max_gpu_parallel = 1
}

process {
    executor      = 'slurm'
    queue         = 'jic-gpu'
    memory        = '8 GB'
    cpus          = 4
    time          = '4h'

    // One failing model must not abort the benchmark. Retry once for transient
    // errors such as a GPU OOM, then skip it so the rest still complete.
    // Preprocessing and aggregation override this to terminate.
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries    = 1
}

profiles {
    standard { process.executor = 'slurm' }
    local    { process.executor = 'local' }
}

singularity {
    enabled = false
}

executor {
    name            = 'slurm'
    queueSize       = 20
    submitRateLimit = '10 sec'
    jobName         = { "bm_${task.process.tokenize(':')[-1]}_${task.index}" }

    // If squeue transiently omits a still-running job, Nextflow waits this
    // long for .exitcode before declaring failure. It returns as soon as the
    // real exit file appears, so a large value never slows a healthy job, but
    // it must exceed the 24h walltime cap. A 20m value once failed a 1h MSA
    // search on a squeue blip.
    exitReadTimeout = '25h'
}

process {

    // Requests are set from measured peaks (sacct MaxRSS over the 2026-08-16
    // run), plus roughly 50% headroom. The previous values were guesses copied
    // from the original bench scripts and over-asked by 3-20x, which limited
    // how many jobs could sit on a node at once.
    //
    // Everything runs on jic-gpu. jic-compute is saturated by other users'
    // thousand-task arrays, and the GPU nodes have 32 CPUs and 1 TB RAM each
    // with only 1 A100, so their CPUs are usually idle. CPU-only processes
    // request no --gres, so they occupy cores without consuming a GPU. The
    // 1 TB also keeps the ColabFold databases in page cache, which is what
    // made the MSA search slow on the 510 GB compute nodes.

    withName: /EXTRACT_SEQUENCES.*|EXTRACT_EFFECTOR_TEMPLATE/ {
        queue         = 'jic-gpu'
        cpus          = 2
        memory        = '4 GB'
        time          = '30m'
        errorStrategy = 'terminate'   // no sequences means nothing to benchmark
    }

    // Measured peak 33.1 GB. CPU-bound MMseqs2, no GPU.
    withName: 'COLABFOLD_SEARCH' {
        queue  = 'jic-gpu'
        cpus   = 16
        memory = '48 GB'
        time   = '4h'
    }

    withName: 'AF3_SETUP_DB' {
        queue  = 'jic-gpu'
        cpus   = 1
        memory = '2 GB'
        time   = '10m'
    }

    // Measured peaks: Boltz-1 6.2 GB, Boltz-2 4.6 GB, Chai-1 10.9 GB.
    withName: /BOLTZ1|BOLTZ1_MSA|BOLTZ1_CONSTRAINED|BOLTZ2|BOLTZ2_MSA|BOLTZ2_CONSTRAINED|BOLTZ2_TEMPLATE|BOLTZ2_MSA_TEMPLATE|BOLTZ2_CONSTRAINED_TEMPLATE|CHAI1/ {
        queue          = 'jic-gpu'
        cpus           = 8
        memory         = '16 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // Measured peaks: AF2M 35.2 GB, AF3 6.8 GB. AF2M keeps more cores because
    // its jackhmmer stage is genuinely parallel; AF3 does not need 20.
    withName: 'AF2M' {
        queue          = 'jic-gpu'
        cpus           = 16
        memory         = '48 GB'
        time           = '24h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    withName: /AF3|AF3_NOMSA/ {
        queue          = 'jic-gpu'
        cpus           = 8
        memory         = '16 GB'
        time           = '24h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // Measured peaks: 2.0 GB and 1.9 GB. These consume the shared MSA rather
    // than building one, so the old 128 GB request was 60x the real use.
    withName: /COLABFOLD|COLABFOLD_NOMSA/ {
        queue          = 'jic-gpu'
        cpus           = 8
        memory         = '12 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // ESMC-6B is ~25 GB in fp32, so this needs a 40 GB GPU. Measured host-RAM
    // peak is 12.9 GB, which is separate from the GPU memory requirement.
    withName: 'ESMFOLD2' {
        queue          = 'jic-gpu'
        cpus           = 8
        memory         = '24 GB'
        time           = '24h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    withName: /METRICS_.*/ {
        queue  = 'jic-gpu'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'AGGREGATE_RESULTS' {
        cpus          = 2
        memory        = '4 GB'
        time          = '30m'
        errorStrategy = 'terminate'   // the final collation must surface
    }
}

// Native trace and report observers replace any custom stats collection.
// workflow.onComplete filters trace.txt down to the predictor processes.
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,queue'
}
dag {
    enabled   = true
    file      = "${params.outdir}/dag.html"
    overwrite = true
}

notification { enabled = false }

manifest {
    name            = 'structure-prediction-benchmarking'
    author          = 'Josh Williams'
    description     = 'Benchmark protein complex structure predictors on plant immune receptor-effector complexes'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0,<26.0.0'   // 26.x rejects top-level def
    version         = '0.1.0'
}
