/*
 * =============================================================================
 * Nextflow Configuration — Structure Prediction Benchmark Pipeline v0.1.0
 * =============================================================================
 *
 * Benchmarks: Boltz-1, Boltz-2 (plus MSA and constrained variants),
 *             Chai-1, AF2-Multimer, AlphaFold 3 (plus no-MSA),
 *             ColabFold (plus no-MSA), ESMFold2.
 *
 * Per-process resource profiles match the SBATCH headers from the original
 * bench_*.sh scripts. GPU jobs are serialized with `maxForks` on each
 * predictor process to respect the small jic-gpu queue at NBI/JIC.
 * =============================================================================
 */

params {
    project_name     = "structure_prediction_benchmark"
    outdir           = "${launchDir}/${params.project_name}_results"

    // Default: one GPU job of a given model at a time. Different models
    // still run in parallel; seeds within a model are already serial.
    max_gpu_parallel = 1
}

process {
    executor      = 'slurm'
    queue         = 'jic-medium'
    memory        = '8 GB'
    cpus          = 4
    time          = '4h'
    // One failing model must not abort the whole benchmark. Retry once for
    // transient errors (e.g. a GPU OOM), then skip that model so the remaining
    // models and the final aggregation still complete. Critical non-model
    // steps (sequence extraction, aggregation) override this to 'terminate'.
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries    = 1
}

profiles {
    standard { process.executor = 'slurm' }
    local    { process.executor = 'local' }
}

singularity {
    enabled = false
}

executor {
    name            = 'slurm'
    queueSize       = 20
    submitRateLimit = '10 sec'
    jobName         = { "bm_${task.process.tokenize(':')[-1]}_${task.index}" }
    // Tolerance for flaky `squeue`: if squeue transiently omits a still-running
    // job, Nextflow thinks it left the queue and waits this long for .exitcode
    // before declaring failure. It returns as soon as the real exit file
    // appears, so a large value never slows a healthy job — but it MUST exceed
    // the longest possible job (24h walltime cap), or a long job gets falsely
    // failed on a squeue blip (a 20m value did exactly that to a 1h MSA search).
    exitReadTimeout = '25h'
}

process {

    // ── Preprocessing ────────────────────────────────────────────────
    withName: /EXTRACT_SEQUENCES.*/ {
        queue         = 'jic-medium'
        cpus          = 2
        memory        = '4 GB'
        time          = '30m'
        errorStrategy = 'terminate'   // no sequences → nothing to benchmark
    }

    // ── Shared ColabFold MMseqs2 search (fans out to *_msa models) ───
    // Matches the colabfold_search step in bench_boltz{1,2}_msa.sh and
    // bench_colabfold.sh — 20 cpus, 128 GB RAM, no GPU.
    withName: 'COLABFOLD_SEARCH' {
        queue  = 'jic-medium'
        cpus   = 20
        memory = '128 GB'
        time   = '4h'
    }

    // ── Boltz-1 family ───────────────────────────────────────────────
    withName: 'BOLTZ1' {
        queue          = 'jic-gpu'
        cpus           = 10
        memory         = '32 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    withName: 'BOLTZ1_MSA' {
        queue          = 'jic-gpu'
        cpus           = 10
        memory         = '32 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    withName: 'BOLTZ1_CONSTRAINED' {
        queue          = 'jic-gpu'
        cpus           = 10
        memory         = '32 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // ── Boltz-2 family ───────────────────────────────────────────────
    withName: 'BOLTZ2' {
        queue          = 'jic-gpu'
        cpus           = 10
        memory         = '32 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    withName: 'BOLTZ2_MSA' {
        queue          = 'jic-gpu'
        cpus           = 10
        memory         = '32 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    withName: 'BOLTZ2_CONSTRAINED' {
        queue          = 'jic-gpu'
        cpus           = 10
        memory         = '32 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // ── Chai-1 ───────────────────────────────────────────────────────
    withName: 'CHAI1' {
        queue          = 'jic-gpu'
        cpus           = 10
        memory         = '32 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // ── AlphaFold 2 Multimer ─────────────────────────────────────────
    withName: 'AF2M' {
        queue          = 'jic-gpu'
        cpus           = 20
        memory         = '64 GB'
        time           = '24h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // ── AlphaFold 3 ──────────────────────────────────────────────────
    withName: 'AF3_SETUP_DB' {
        queue  = 'jic-medium'
        cpus   = 1
        memory = '2 GB'
        time   = '10m'
    }

    withName: 'AF3' {
        queue          = 'jic-gpu'
        cpus           = 20
        memory         = '64 GB'
        time           = '24h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    withName: 'AF3_NOMSA' {
        queue          = 'jic-gpu'
        cpus           = 8
        memory         = '32 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // ── ColabFold ────────────────────────────────────────────────────
    withName: 'COLABFOLD' {
        queue          = 'jic-gpu'
        cpus           = 20
        memory         = '128 GB'
        time           = '24h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    withName: 'COLABFOLD_NOMSA' {
        queue          = 'jic-gpu'
        cpus           = 8
        memory         = '32 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // ── ESMFold2 ─────────────────────────────────────────────────────
    // ESMC-6B backbone is ~25 GB fp32 → needs a 40 GB+ GPU and lots of RAM
    // (the container test used --mem=96G). 5 seeds run serially in one job,
    // so give it a long walltime. If your GPU partition mixes card sizes,
    // add a constraint to clusterOptions, e.g. '--gres=gpu:1 --constraint=a100'.
    withName: 'ESMFOLD2' {
        queue          = 'jic-gpu'
        cpus           = 8
        memory         = '96 GB'
        time           = '24h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_gpu_parallel
    }

    // ── Metrics computation (CPU, one per model) ─────────────────────
    // All COMPUTE_METRICS aliases share the same CPU profile.  Each alias
    // (METRICS_BOLTZ1, METRICS_AF2M, ...) appears under its aliased name
    // in the task graph, so we match them with a METRICS_* regex.
    withName: /METRICS_.*/ {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    // ── Aggregation ──────────────────────────────────────────────────
    withName: 'AGGREGATE_RESULTS' {
        queue         = 'jic-medium'
        cpus          = 2
        memory        = '4 GB'
        time          = '30m'
        errorStrategy = 'terminate'   // final collation must succeed or surface
    }
}

// ── Trace / report / timeline ─────────────────────────────────────────
// These replace the old collect_slurm_stats.sh by giving per-task
// runtime, CPU, RSS, peak vmem, exit code, and queue directly from
// Nextflow's executor introspection.
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,queue'
}
dag {
    enabled   = true
    file      = "${params.outdir}/dag.html"
    overwrite = true
}

notification { enabled = false }

manifest {
    name            = 'structure-prediction-benchmarking'
    author          = 'Josh Williams'
    description     = 'Multi-model protein complex structure prediction benchmark (Boltz-1/2, Chai-1, AF2M, AF3, ColabFold) on plant immune receptor-effector complexes'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}
